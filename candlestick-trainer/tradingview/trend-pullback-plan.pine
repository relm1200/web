// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Trend Pullback Plan
//
// Automates the "USD/JPY 5-Minute Trading Plan":
//   1. Direction filter: MA ribbon stacked + price beyond the middle average, momentum
//      (MACD 12/26/9) beyond zero, Vortex (50) in the same direction,
//      and market structure (HH+HL or LH+LL). All four must agree.
//   2. Location: the pattern reaches the middle average or one of your levels.
//   3. Trigger: a closed pattern (shorts: Bearish Engulfing, Shooting Star, Evening Star,
//      Dark Cloud Cover; longs: Bullish Engulfing, Hammer, Morning Star, Piercing Line),
//      using the Wick Reader trainer's shape rules.
//   4. Stop just beyond the pattern (optionally beyond the latest swing if further), skipped
//      if past the slow average; first target = the next level, needs at least 1.5R.
// Signals mark the candle that completes the setup; the plan enters at the next open.
//
// Educational tool, not financial advice. Test it (Bar Replay, demo) before real money.

//@version=6
indicator("Trend Pullback Plan", shorttitle = "TPP", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ───────────── inputs ─────────────
G_T = "Trend tools (match your chart)"
i_maType   = input.string("EMA", "Average type", options = ["EMA", "SMA"], group = G_T)
i_fast     = input.int(8, "Fast average", minval = 1, group = G_T, inline = "g_t_ma")
i_mid      = input.int(20, "Middle", minval = 1, group = G_T, inline = "g_t_ma")
i_slow     = input.int(50, "Slow", minval = 1, group = G_T, inline = "g_t_ma")
i_mFast    = input.int(12, "Momentum fast", minval = 1, group = G_T, inline = "g_t_m")
i_mSlow    = input.int(26, "slow", minval = 1, group = G_T, inline = "g_t_m")
i_mSig     = input.int(9, "signal", minval = 1, group = G_T, inline = "g_t_m")
i_momSig   = input.bool(false, "Momentum: also require the line beyond its signal line", group = G_T, tooltip = "Off by default. A pullback lifts momentum through its signal line, so this rule blocks most pullback entries.")
i_viLen    = input.int(50, "Vortex length", minval = 2, group = G_T)
i_swingN   = input.int(2, "Swing strength (candles each side)", minval = 1, maxval = 10, group = G_T)

G_E = "Entry"
i_zoneTol    = input.float(0.3, "Pullback zone: within N avg ranges of the middle average or a level", minval = 0.0, step = 0.1, group = G_E)
i_requireCtx = input.bool(false, "Also require each pattern's own trend context (Wick Reader rule)", group = G_E)
i_chopBars   = input.int(20, "Choppy if momentum crosses zero", minval = 5, group = G_E, inline = "g_e_c")
i_chopMax    = input.int(3, "times or more in N candles", minval = 1, group = G_E, inline = "g_e_c")
i_useSess    = input.bool(false, "Only trade during this session", group = G_E, inline = "g_e_s")
i_sess       = input.session("0700-2000", "", group = G_E, inline = "g_e_s")

G_L = "Your levels (0 = off). Update them each day."
i_l1 = input.float(0.0, "Level 1", step = 0.001, group = G_L, inline = "g_l_a")
i_l2 = input.float(0.0, "Level 2", step = 0.001, group = G_L, inline = "g_l_a")
i_l3 = input.float(0.0, "Level 3", step = 0.001, group = G_L, inline = "g_l_b")
i_l4 = input.float(0.0, "Level 4", step = 0.001, group = G_L, inline = "g_l_b")
i_lvlLook = input.int(100, "Also use swing highs/lows from the last N candles as levels", minval = 10, group = G_L)
i_tgtN    = input.int(5, "Swing strength for those levels (candles each side)", minval = 1, maxval = 20, group = G_L, tooltip = "Larger = only clearer swings count as targets. 2-candle swings are mostly noise on 5-minute charts.")

G_R = "Risk"
i_stopMode = input.string("Pattern", "Stop goes beyond", options = ["Pattern", "Pattern or latest swing (further)"], group = G_R, tooltip = "Pattern = the Monster Guide's stop, just beyond the pattern's extreme. The swing option gives a wider stop and fewer trades that reach 1.5R.")
i_bufPips = input.float(2.0, "Stop buffer (pips)", minval = 0.0, step = 0.5, group = G_R)
i_minRR   = input.float(1.5, "Minimum reward:risk to the first target", minval = 0.5, step = 0.1, group = G_R)
i_acct    = input.float(10000, "Account balance (USD)", minval = 0, group = G_R)
i_riskPct = input.float(1.0, "Risk per trade (%)", minval = 0.1, maxval = 5, step = 0.1, group = G_R)

G_D = "Display"
i_showMA   = input.bool(true, "Plot the averages", group = G_D)
i_bg       = input.bool(true, "Tint the background while all four filters agree", group = G_D)
i_lines    = input.bool(true, "Draw entry, stop and targets on signals", group = G_D)
i_table    = input.bool(true, "Show the checklist table", group = G_D)
i_bullCol  = input.color(#0d8566, "Long", group = G_D, inline = "g_d_c")
i_bearCol  = input.color(#c3313f, "Short", group = G_D, inline = "g_d_c")
i_entryCol = input.color(#2a43c4, "Entry", group = G_D, inline = "g_d_c")

avgRange = ta.sma(high - low, 10)

// ───────────── candle helpers (k = bars back; same rules as Wick Reader) ─────────────
rng(int k)  => high[k] - low[k]
bod(int k)  => math.abs(close[k] - open[k])
bTop(int k) => math.max(open[k], close[k])
bBot(int k) => math.min(open[k], close[k])
upw(int k)  => high[k] - bTop(k)
low_w(int k) => bBot(k) - low[k]
isBull(int k) => close[k] > open[k]
isBear(int k) => close[k] < open[k]
closePos(int k) => rng(k) > 0 ? (close[k] - low[k]) / rng(k) : 0.5
isSmallBody(int k) => bod(k) > 0.1 * rng(k) and bod(k) <= 0.35 * rng(k)
isLongBody(int k, float a) => bod(k) >= 0.6 * rng(k) and bod(k) >= 0.8 * a
hammerShape(int k, float a) =>
    isSmallBody(k) and low_w(k) >= 2 * bod(k) and low_w(k) >= 0.55 * rng(k) and upw(k) <= 0.12 * rng(k) and rng(k) >= 0.7 * a and closePos(k) >= 0.75
invertedShape(int k, float a) =>
    isSmallBody(k) and upw(k) >= 2 * bod(k) and upw(k) >= 0.55 * rng(k) and low_w(k) <= 0.12 * rng(k) and rng(k) >= 0.7 * a and closePos(k) <= 0.25

// ───────────── pattern context ─────────────
atrFor(int L) => avgRange[L]
trendFor(int L) =>
    a = atrFor(L)
    m = a > 0 ? (close[L] - open[L + 5]) / a : 0.0
    m <= -1.5 ? -1 : m >= 1.5 ? 1 : 0
a1 = atrFor(1)
a2 = atrFor(2)
a3 = atrFor(3)
t1 = trendFor(1)
t2 = trendFor(2)
t3 = trendFor(3)

// ───────────── triggers (shape rules; trend context optional) ─────────────
bearEngS = isBull(1) and bod(1) >= 0.3 * a2 and isBear(0) and open >= close[1] and close <= open[1] and bod(0) > 1.1 * bod(1)
sstarS   = invertedShape(0, a1)
estarS   = isBull(2) and isLongBody(2, a3) and bod(1) <= 0.3 * bod(2) and rng(1) <= 0.6 * rng(2) and bBot(1) >= close[2] - 0.1 * bod(2) and isBear(0) and close <= close[2] - 0.5 * bod(2)
dccS     = isBull(1) and isLongBody(1, a2) and isBear(0) and open >= close[1] and close < close[1] - 0.5 * bod(1) and close > open[1]
bullEngS = isBear(1) and bod(1) >= 0.3 * a2 and isBull(0) and open <= close[1] and close >= open[1] and bod(0) > 1.1 * bod(1)
hamS     = hammerShape(0, a1)
mstarS   = isBear(2) and isLongBody(2, a3) and bod(1) <= 0.3 * bod(2) and rng(1) <= 0.6 * rng(2) and bTop(1) <= close[2] + 0.1 * bod(2) and isBull(0) and close >= close[2] + 0.5 * bod(2)
pierceS  = isBear(1) and isLongBody(1, a2) and isBull(0) and open <= close[1] and close > close[1] + 0.5 * bod(1) and close < open[1]

bearEng = bearEngS and (not i_requireCtx or t2 == 1)
sstar   = sstarS and (not i_requireCtx or t1 == 1)
estar   = estarS and (not i_requireCtx or t3 == 1)
dcc     = dccS and (not i_requireCtx or t2 == 1)
bullEng = bullEngS and (not i_requireCtx or t2 == -1)
ham     = hamS and (not i_requireCtx or t1 == -1)
mstar   = mstarS and (not i_requireCtx or t3 == -1)
pierce  = pierceS and (not i_requireCtx or t2 == -1)

bearName = estar ? "Evening Star" : bearEng ? "Bearish Engulfing" : dcc ? "Dark Cloud Cover" : sstar ? "Shooting Star" : ""
bearLen  = estar ? 3 : bearEng or dcc ? 2 : 1
bullName = mstar ? "Morning Star" : bullEng ? "Bullish Engulfing" : pierce ? "Piercing Line" : ham ? "Hammer" : ""
bullLen  = mstar ? 3 : bullEng or pierce ? 2 : 1

// highest high / lowest low of the last L candles
patHigh(int L) =>
    hi = high
    for j = 1 to L
        if j < L
            hi := math.max(hi, high[j])
    hi
patLow(int L) =>
    lo = low
    for j = 1 to L
        if j < L
            lo := math.min(lo, low[j])
    lo

// ───────────── plan logic (values in, decision out) ─────────────
// 1 = long allowed, -1 = short allowed, 0 = no trade
filterDir(float f, float m, float s, float c, float mac, float sig, float vp, float vm, int st, bool reqSig) =>
    bull = f > m and m > s and c > m and mac > 0 and (not reqSig or mac > sig) and vp > vm and st == 1
    bear = f < m and m < s and c < m and mac < 0 and (not reqSig or mac < sig) and vm > vp and st == -1
    bull ? 1 : bear ? -1 : 0

// did the pattern reach the middle average or one of the user's levels, and close back on the right side?
inZone(int dir, float ext, float c, float midMA, float a, float tol, array<float> manual) =>
    near = dir < 0 ? ext >= midMA - tol * a : ext <= midMA + tol * a
    for j = 0 to manual.size()
        if j < manual.size()
            lv = manual.get(j)
            if dir < 0 ? ext >= lv - tol * a and c <= lv : ext <= lv + tol * a and c >= lv
                near := true
    near

// stop beyond the pattern or the latest swing, targets = the next levels in the trade's direction
planTrade(int dir, float entry, float ext, float swingExt, float slowMA, float a, float buf, float minRR, array<float> levels) =>
    base = na(swingExt) ? ext : dir < 0 ? math.max(ext, swingExt) : math.min(ext, swingExt)
    stop = dir < 0 ? base + buf : base - buf
    risk = math.abs(entry - stop)
    stopOk = dir < 0 ? stop <= slowMA : stop >= slowMA
    float t1 = na
    for j = 0 to levels.size()
        if j < levels.size()
            lv = levels.get(j)
            if dir < 0 ? lv < entry : lv > entry
                if na(t1) or (dir < 0 ? lv > t1 : lv < t1)
                    t1 := lv
    float t2 = na
    for j = 0 to levels.size()
        if j < levels.size() and not na(t1)
            lv = levels.get(j)
            if dir < 0 ? lv < t1 - 0.25 * a : lv > t1 + 0.25 * a
                if na(t2) or (dir < 0 ? lv > t2 : lv < t2)
                    t2 := lv
    rr1 = risk > 0 and not na(t1) ? math.abs(t1 - entry) / risk : na
    rrOk = not na(rr1) and rr1 >= minRR
    [stopOk and rrOk, stop, t1, t2, rr1, stopOk, rrOk]

// ───────────── series ─────────────
emaF = ta.ema(close, i_fast)
emaM = ta.ema(close, i_mid)
emaS = ta.ema(close, i_slow)
smaF = ta.sma(close, i_fast)
smaM = ta.sma(close, i_mid)
smaS = ta.sma(close, i_slow)
maF = i_maType == "EMA" ? emaF : smaF
maM = i_maType == "EMA" ? emaM : smaM
maS = i_maType == "EMA" ? emaS : smaS
plot(i_showMA ? maF : na, "Fast average", color = color.new(#e0b54a, 0), linewidth = 2)
plot(i_showMA ? maM : na, "Middle average", color = color.new(#3bb3c3, 0), linewidth = 2)
plot(i_showMA ? maS : na, "Slow average", color = color.new(#c3313f, 0), linewidth = 2)

[macdLine, sigLine, histLine] = ta.macd(close, i_mFast, i_mSlow, i_mSig)

vmP = math.abs(high - low[1])
vmM = math.abs(low - high[1])
trV = ta.tr(true)
viP = math.sum(vmP, i_viLen) / math.sum(trV, i_viLen)
viM = math.sum(vmM, i_viLen) / math.sum(trV, i_viLen)

chop = math.sum(ta.cross(macdLine, 0) ? 1 : 0, i_chopBars) >= i_chopMax
sessOk = not i_useSess or not na(time(timeframe.period, i_sess))

// market structure: strict n-bar swings, highs and lows alternate (same as Wick Reader)
n = i_swingN
swingHighN(int m) =>
    ok = bar_index >= 2 * m
    for j = 0 to 2 * m
        if j != m and high[j] >= high[m]
            ok := false
    ok
swingLowN(int m) =>
    ok = bar_index >= 2 * m
    for j = 0 to 2 * m
        if j != m and low[j] <= low[m]
            ok := false
    ok
swH = swingHighN(n)
swL = swingLowN(n)
tgH = swingHighN(i_tgtN)
tgL = swingLowN(i_tgtN)

var int lastKind = 0
var float hiCur = na
var float hiRef = na
var float loCur = na
var float loRef = na
var string hiTag = ""
var string loTag = ""
if swH
    p = high[n]
    if lastKind != 1 or p > hiCur
        if lastKind != 1
            hiRef := hiCur
        hiCur := p
        lastKind := 1
        hiTag := na(hiRef) ? "" : p > hiRef ? "HH" : "LH"
if swL
    p = low[n]
    if lastKind != -1 or p < loCur
        if lastKind != -1
            loRef := loCur
        loCur := p
        lastKind := -1
        loTag := na(loRef) ? "" : p > loRef ? "HL" : "LL"
sTrend = hiTag == "HH" and loTag == "HL" ? 1 : hiTag == "LH" and loTag == "LL" ? -1 : 0

// levels for targets: confirmed swings from the last i_lvlLook candles + your levels
var array<float> lvlPrice = array.new<float>()
var array<int> lvlConf = array.new<int>()
if tgH
    lvlPrice.push(high[i_tgtN])
    lvlConf.push(bar_index)
if tgL
    lvlPrice.push(low[i_tgtN])
    lvlConf.push(bar_index)
while lvlConf.size() > 0 and lvlConf.first() < bar_index - i_lvlLook
    lvlPrice.shift()
    lvlConf.shift()
manual = array.new<float>()
if i_l1 > 0
    manual.push(i_l1)
if i_l2 > 0
    manual.push(i_l2)
if i_l3 > 0
    manual.push(i_l3)
if i_l4 > 0
    manual.push(i_l4)
allLv = array.concat(array.copy(lvlPrice), manual)

// ───────────── decisions ─────────────
pipSize = syminfo.type == "forex" ? syminfo.mintick * 10 : syminfo.mintick
buf = i_bufPips * pipSize
dir = filterDir(maF, maM, maS, close, macdLine, sigLine, viP, viM, sTrend, i_momSig)

bearExt = patHigh(bearLen)
bullExt = patLow(bullLen)
bearA = atrFor(bearLen)
bullA = atrFor(bullLen)
bearZone = inZone(-1, bearExt, close, maM, bearA, i_zoneTol, manual)
bullZone = inZone(1, bullExt, close, maM, bullA, i_zoneTol, manual)
[bearOk, bearStop, bearT1, bearT2, bearRR, bearStopOk, bearRROk] = planTrade(-1, close, bearExt, i_stopMode == "Pattern" ? na : hiCur, maS, bearA, buf, i_minRR, allLv)
[bullOk, bullStop, bullT1, bullT2, bullRR, bullStopOk, bullRROk] = planTrade(1, close, bullExt, i_stopMode == "Pattern" ? na : loCur, maS, bullA, buf, i_minRR, allLv)

sellSignal = barstate.isconfirmed and sessOk and not chop and dir == -1 and bearName != "" and bearZone and bearOk
buySignal  = barstate.isconfirmed and sessOk and not chop and dir == 1 and bullName != "" and bullZone and bullOk

// ───────────── drawing ─────────────
bgcolor(i_bg and dir == -1 ? color.new(i_bearCol, 93) : i_bg and dir == 1 ? color.new(i_bullCol, 93) : na)

// pip value per standard lot in USD: quote currency USD, or base currency USD (e.g. USD/JPY)
pipValueUsd = syminfo.currency == "USD" ? 100000 * pipSize : syminfo.basecurrency == "USD" ? 100000 * pipSize / close : na
lotsFor(float stopDist) => na(pipValueUsd) or stopDist <= 0 ? na : i_acct * i_riskPct / 100 / (stopDist / pipSize * pipValueUsd)
fmtP(float v) => na(v) ? "-" : str.tostring(v, format.mintick)

drawPlan(int dir0, string name, float stop, float t1, float t2, float rr, color col) =>
    entry = close
    stopPips = math.abs(entry - stop) / pipSize
    lots = lotsFor(math.abs(entry - stop))
    txt = (dir0 < 0 ? "SELL " : "BUY ") + name + "\nEntry ≈ " + fmtP(entry) + " (next open)\nStop " + fmtP(stop) + " (" + str.tostring(stopPips, "#.#") + " pips)\nT1 " + fmtP(t1) + " (" + str.tostring(rr, "#.#") + "R), take half\nT2 " + fmtP(t2) + (na(lots) ? "" : "\nSize " + str.tostring(lots, "#.##") + " lots at " + str.tostring(i_riskPct) + "%")
    label.new(bar_index, dir0 < 0 ? high : low, txt, yloc = dir0 < 0 ? yloc.abovebar : yloc.belowbar, style = dir0 < 0 ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.small)
    if i_lines
        line.new(bar_index, entry, bar_index + 12, entry, color = i_entryCol)
        line.new(bar_index, stop, bar_index + 12, stop, color = i_bearCol, style = line.style_dotted)
        if not na(t1)
            line.new(bar_index, t1, bar_index + 12, t1, color = i_bullCol, style = line.style_dashed)
        if not na(t2)
            line.new(bar_index, t2, bar_index + 12, t2, color = i_bullCol, style = line.style_dotted)

if sellSignal
    drawPlan(-1, bearName, bearStop, bearT1, bearT2, bearRR, i_bearCol)
    alert(syminfo.ticker + " " + timeframe.period + ": SELL " + bearName + ", entry ≈ " + fmtP(close) + ", stop " + fmtP(bearStop) + ", T1 " + fmtP(bearT1), alert.freq_once_per_bar_close)
if buySignal
    drawPlan(1, bullName, bullStop, bullT1, bullT2, bullRR, i_bullCol)
    alert(syminfo.ticker + " " + timeframe.period + ": BUY " + bullName + ", entry ≈ " + fmtP(close) + ", stop " + fmtP(bullStop) + ", T1 " + fmtP(bullT1), alert.freq_once_per_bar_close)

// checklist table
var table tbl = table.new(position.top_right, 2, 8, border_width = 1)
if i_table and barstate.islast
    stackBull = maF > maM and maM > maS and close > maM
    stackBear = maF < maM and maM < maS and close < maM
    momBull = macdLine > 0 and (not i_momSig or macdLine > sigLine)
    momBear = macdLine < 0 and (not i_momSig or macdLine < sigLine)
    biasTxt = dir == 1 ? "LONGS only" : dir == -1 ? "SHORTS only" : "No trade (filters disagree)"
    biasCol = dir == 1 ? i_bullCol : dir == -1 ? i_bearCol : chart.fg_color
    table.cell(tbl, 0, 0, "Bias", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 0, biasTxt, text_color = biasCol, text_size = size.small)
    table.cell(tbl, 0, 1, "MA ribbon", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 1, stackBull ? "✓ bullish stack" : stackBear ? "✓ bearish stack" : "✗ tangled", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 2, "Momentum", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 2, momBull ? "✓ above zero" : momBear ? "✓ below zero" : "✗ mixed", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 3, "Vortex", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 3, viP > viM ? "VI+ above" : "VI- above", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 4, "Structure", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 4, (hiTag == "" ? "-" : hiTag) + " / " + (loTag == "" ? "-" : loTag), text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 5, "Choppy", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 5, chop ? "✗ yes, stand aside" : "✓ no", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 6, "Session", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 6, sessOk ? "✓ open" : "✗ outside", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 7, "Daily limit", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 7, "Stop after 2 losses or -2R", text_color = chart.fg_color, text_size = size.small)

alertcondition(sellSignal, "Sell setup", "{{ticker}} {{interval}}: sell setup from the Trend Pullback Plan")
alertcondition(buySignal, "Buy setup", "{{ticker}} {{interval}}: buy setup from the Trend Pullback Plan")
alertcondition(dir != dir[1], "Bias changed", "{{ticker}} {{interval}}: Trend Pullback Plan bias changed")
